+import { runInNewContext } from 'vm';
+import {
+  browserPageCaptureScript,
+  cancelBrowserPage,
+  fetchBrowserPage,
+  getBrowserPageRequest,
+  receiveBrowserPage,
+  registerBrowserPageHost,
+  setBrowserPageForeground,
+} from '../browser';
+
+const site = 'https://novtales.com';
+const options = { readySelector: 'article', readyText: 'End of Chapter 1' };
+
+describe('browser page delivery', () => {
+  let dispose: () => void;
+
+  beforeEach(() => {
+    jest.useFakeTimers();
+    setBrowserPageForeground(true);
+    dispose = registerBrowserPageHost();
+  });
+
+  afterEach(() => {
+    dispose();
+    jest.useRealTimers();
+  });
+
+  const respond = (
+    id: number,
+    url: string,
+    html = '<article>Complete</article>',
+  ) =>
+    receiveBrowserPage(
+      id,
+      JSON.stringify({ type: 'lnreader-browser-page', id, url, html }),
+      url,
+    );
+
+  it('serializes pages and ignores a stale or redirected result', async () => {
+    const first = fetchBrowserPage(
+      'NovTales',
+      site,
+      site + '/chapter/test-1',
+      options,
+    );
+    const firstId = getBrowserPageRequest()!.id;
+    const second = fetchBrowserPage(
+      'NovTales',
+      site,
+      site + '/chapter/test-2',
+      options,
+    );
+    respond(firstId, site + '/signin');
+    expect(getBrowserPageRequest()!.id).toBe(firstId);
+    respond(firstId, site + '/chapter/test-1');
+    await expect(first).resolves.toMatchObject({
+      url: site + '/chapter/test-1',
+    });
+    const secondId = getBrowserPageRequest()!.id;
+    respond(firstId, site + '/chapter/test-1');
+    expect(getBrowserPageRequest()!.id).toBe(secondId);
+    respond(secondId, site + '/chapter/test-2');
+    await expect(second).resolves.toMatchObject({
+      url: site + '/chapter/test-2',
+    });
+    expect(getBrowserPageRequest()).toBeUndefined();
+  });
+
+  it('rejects exports from another frame even when their payload claims the right URL', async () => {
+    const result = fetchBrowserPage(
+      'NovTales',
+      site,
+      site + '/explore',
+      options,
+    );
+    const id = getBrowserPageRequest()!.id;
+    receiveBrowserPage(
+      id,
+      JSON.stringify({
+        type: 'lnreader-browser-page',
+        id,
+        url: site + '/explore',
+        html: '<article>Forged</article>',
+      }),
+      'https://other.example/explore',
+    );
+    expect(getBrowserPageRequest()!.id).toBe(id);
+    respond(id, site + '/explore', '<article>Actual</article>');
+    await expect(result).resolves.toMatchObject({
+      html: '<article>Actual</article>',
+    });
+  });
+
+  it('starts each timeout when its page opens, not while it is queued', async () => {
+    const first = fetchBrowserPage('NovTales', site, site + '/one', {
+      ...options,
+      timeoutMs: 10000,
+    });
+    const id = getBrowserPageRequest()!.id;
+    const second = fetchBrowserPage('NovTales', site, site + '/two', {
+      ...options,
+      timeoutMs: 10000,
+    });
+    jest.advanceTimersByTime(9000);
+    respond(id, site + '/one');
+    await first;
+    jest.advanceTimersByTime(9000);
+    expect(getBrowserPageRequest()!.url).toBe(site + '/two');
+    const rejection = second.catch(error => error);
+    jest.advanceTimersByTime(1001);
+    expect((await rejection).message).toContain('did not finish');
+  });
+
+  it('rejects cross-origin and insecure requests before opening a page', async () => {
+    await expect(
+      fetchBrowserPage('NovTales', 'invalid', 'invalid', options),
+    ).rejects.toThrow('invalid');
+    await expect(
+      fetchBrowserPage('NovTales', site, 'https://other.example/', options),
+    ).rejects.toThrow('belong');
+    await expect(
+      fetchBrowserPage(
+        'NovTales',
+        'http://novtales.com',
+        'http://novtales.com',
+        options,
+      ),
+    ).rejects.toThrow('belong');
+    expect(getBrowserPageRequest()).toBeUndefined();
+  });
+
+  it('cancels pending pages in the background and requires a foreground retry', async () => {
+    const first = fetchBrowserPage(
+      'NovTales',
+      site,
+      site + '/one',
+      options,
+    ).catch(error => error);
+    const second = fetchBrowserPage(
+      'NovTales',
+      site,
+      site + '/two',
+      options,
+    ).catch(error => error);
+    setBrowserPageForeground(false);
+    expect((await first).message).toContain('Return to LNReader');
+    expect((await second).message).toContain('Return to LNReader');
+    await expect(
+      fetchBrowserPage('NovTales', site, site + '/three', options),
+    ).rejects.toThrow('Return to LNReader');
+    expect(getBrowserPageRequest()).toBeUndefined();
+  });
+
+  it('lets cancellation advance the queue and closes all requests when the host unmounts', async () => {
+    const first = fetchBrowserPage('NovTales', site, site + '/one', options);
+    const second = fetchBrowserPage('NovTales', site, site + '/two', options);
+    const firstRejection = first.catch(error => error);
+    cancelBrowserPage(getBrowserPageRequest()!.id);
+    expect((await firstRejection).message).toContain('cancelled');
+    expect(getBrowserPageRequest()!.url).toBe(site + '/two');
+    const secondRejection = second.catch(error => error);
+    dispose();
+    dispose = () => undefined;
+    expect((await secondRejection).message).toContain('closed');
+    expect(getBrowserPageRequest()).toBeUndefined();
+  });
+
+  it('captures only after full content appears and refuses a verification page or redirect', () => {
+    const postMessage = jest.fn();
+    const node = { textContent: 'A chapter preview' };
+    const document = {
+      title: 'Chapter 1',
+      readyState: 'complete',
+      documentElement: { outerHTML: '<article>Full chapter</article>' },
+      querySelectorAll: () => [node],
+    };
+    const location = {
+      origin: site,
+      pathname: '/chapter/test-1',
+      search: '',
+      href: site + '/chapter/test-1',
+    };
+    let mutated: () => void = () => undefined;
+    class MutationObserver {
+      constructor(callback: () => void) {
+        mutated = callback;
+      }
+      observe() {
+        /* DOM changes are driven explicitly by this test. */
+      }
+      disconnect() {
+        /* No real observer is installed in this isolated scope. */
+      }
+    }
+    runInNewContext(
+      browserPageCaptureScript({
+        ...options,
+        readyTextExact: true,
+        id: 42,
+        pluginName: 'NovTales',
+        url: location.href,
+      }),
+      {
+        document,
+        location,
+        URL,
+        MutationObserver,
+        setTimeout,
+        clearTimeout,
+        window: {
+          ReactNativeWebView: { postMessage },
+          addEventListener: jest.fn(),
+        },
+      },
+    );
+    jest.advanceTimersByTime(201);
+    expect(postMessage).not.toHaveBeenCalled();
+    node.textContent = 'End of Chapter 10';
+    mutated();
+    jest.advanceTimersByTime(201);
+    expect(postMessage).not.toHaveBeenCalled();
+    node.textContent = 'End of Chapter 1';
+    document.title = 'Vercel Security Checkpoint';
+    mutated();
+    jest.advanceTimersByTime(201);
+    expect(postMessage).not.toHaveBeenCalled();
+    document.title = 'Chapter 1';
+    location.pathname = '/signin';
+    mutated();
+    jest.advanceTimersByTime(201);
+    expect(postMessage).not.toHaveBeenCalled();
+    location.pathname = '/chapter/test-1';
+    mutated();
+    jest.advanceTimersByTime(201);
+    expect(postMessage).toHaveBeenCalledTimes(1);
+    expect(JSON.parse(postMessage.mock.calls[0][0])).toMatchObject({
+      type: 'lnreader-browser-page',
+      id: 42,
+      html: '<article>Full chapter</article>',
+    });
+  });
+});
diff --git a/src/plugins/helpers/browser.ts b/src/plugins/helpers/browser.ts
new file mode 100644
index 0000000..b50e6cb
--- /dev/null
+++ b/src/plugins/helpers/browser.ts
@@ -0,0 +1,225 @@
+export type BrowserPageOptions = {
+  readySelector: string;
+  readyText?: string;
+  readyTextExact?: boolean;
+  instruction?: string;
+  timeoutMs?: number;
+};
+
+export type BrowserPage = {
+  url: string;
+  html: string;
+};
+
+export type BrowserPageRequest = BrowserPageOptions & {
+  id: number;
+  pluginName: string;
+  url: string;
+};
+
+type PendingPage = {
+  request: BrowserPageRequest;
+  resolve: (page: BrowserPage) => void;
+  reject: (error: Error) => void;
+};
+
+let nextId = 0;
+let active: PendingPage | undefined;
+let timer: ReturnType<typeof setTimeout> | undefined;
+let hostCount = 0;
+let foreground = true;
+const queue: PendingPage[] = [];
+const listeners = new Set<() => void>();
+
+export const getBrowserPageRequest = () => active?.request;
+
+export const subscribeBrowserPage = (listener: () => void) => {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+};
+
+const notify = () => listeners.forEach(listener => listener());
+
+const startNext = () => {
+  active = queue.shift();
+  if (active) {
+    const id = active.request.id;
+    timer = setTimeout(
+      () => cancelBrowserPage(id, 'The website did not finish loading.'),
+      active.request.timeoutMs,
+    );
+  }
+  notify();
+};
+
+const settle = (id: number, page?: BrowserPage, error?: Error) => {
+  if (active?.request.id !== id) return;
+  const pending = active;
+  clearTimeout(timer);
+  timer = undefined;
+  active = undefined;
+  if (page) pending.resolve(page);
+  else pending.reject(error || new Error('Website loading was cancelled.'));
+  startNext();
+};
+
+export const cancelBrowserPage = (id: number, message?: string) =>
+  settle(id, undefined, new Error(message || 'Website loading was cancelled.'));
+
+const closeAll = (message: string) => {
+  clearTimeout(timer);
+  timer = undefined;
+  const pending = [active, ...queue];
+  active = undefined;
+  queue.length = 0;
+  pending.forEach(page => page?.reject(new Error(message)));
+  notify();
+};
+
+export const setBrowserPageForeground = (available: boolean) => {
+  foreground = available;
+  if (!available) closeAll('Return to LNReader to load this website.');
+};
+
+const samePage = (expected: string, actual: string) => {
+  try {
+    const target = new URL(expected);
+    const received = new URL(actual);
+    return (
+      target.origin === received.origin &&
+      target.pathname === received.pathname &&
+      target.search === received.search
+    );
+  } catch {
+    return false;
+  }
+};
+
+export const receiveBrowserPage = (
+  id: number,
+  data: string,
+  eventUrl: string,
+) => {
+  if (active?.request.id !== id) return;
+  try {
+    const page = JSON.parse(data);
+    if (
+      page.type !== 'lnreader-browser-page' ||
+      page.id !== id ||
+      !samePage(active.request.url, eventUrl) ||
+      !samePage(active.request.url, page.url)
+    ) {
+      return;
+    }
+    if (typeof page.error === 'string') {
+      cancelBrowserPage(id, page.error);
+    } else if (typeof page.html === 'string' && page.html.trim()) {
+      settle(id, { html: page.html, url: page.url });
+    }
+  } catch {
+    // Page scripts may use the WebView message channel for unrelated events.
+  }
+};
+
+export const registerBrowserPageHost = () => {
+  hostCount++;
+  return () => {
+    hostCount--;
+    if (hostCount !== 0) return;
+    closeAll('The website browser was closed.');
+  };
+};
+
+export const fetchBrowserPage = (
+  pluginName: string,
+  site: string,
+  url: string,
+  options: BrowserPageOptions,
+): Promise<BrowserPage> => {
+  let source: URL;
+  let target: URL;
+  try {
+    source = new URL(site);
+    target = new URL(url, site);
+  } catch {
+    return Promise.reject(new Error('The website URL is invalid.'));
+  }
+  if (source.protocol !== 'https:' || target.origin !== source.origin) {
+    return Promise.reject(new Error('The page must belong to this source.'));
+  }
+  if (!hostCount) {
+    return Promise.reject(new Error('The website browser is not available.'));
+  }
+  if (!foreground) {
+    return Promise.reject(
+      new Error('Return to LNReader to load this website.'),
+    );
+  }
+  if (!options.readySelector || queue.length >= 8) {
+    return Promise.reject(new Error('Too many website requests are waiting.'));
+  }
+  return new Promise((resolve, reject) => {
+    queue.push({
+      request: {
+        ...options,
+        id: ++nextId,
+        pluginName,
+        url: target.href,
+        timeoutMs: Math.max(
+          1000,
+          Math.min(options.timeoutMs || 600000, 1800000),
+        ),
+      },
+      resolve,
+      reject,
+    });
+    if (!active) startNext();
+  });
+};
+
+export const browserPageCaptureScript = (request: BrowserPageRequest) => `
+(function () {
+  var config = ${JSON.stringify({
+    id: request.id,
+    url: request.url,
+    selector: request.readySelector,
+    text: request.readyText || '',
+    exact: request.readyTextExact === true,
+  }).replace(/</g, '\\u003c')};
+  var sent = false;
+  var timer;
+  var observer;
+  function send(result) {
+    if (sent) return;
+    sent = true;
+    if (observer) observer.disconnect();
+    clearTimeout(timer);
+    window.ReactNativeWebView.postMessage(JSON.stringify(Object.assign({
+      type: 'lnreader-browser-page', id: config.id, url: location.href
+    }, result)));
+  }
+  function inspect() {
+    if (sent) return;
+    var expected = new URL(config.url);
+    if (location.origin !== expected.origin || location.pathname !== expected.pathname || location.search !== expected.search) return;
+    if (/Vercel Security Checkpoint|Just a moment/i.test(document.title)) return;
+    try {
+      var nodes = Array.from(document.querySelectorAll(config.selector));
+      var text = config.text.replace(/\\s+/g, ' ').trim();
+      var ready = nodes.some(function(node) {
+        var content = (node.textContent || '').replace(/\\s+/g, ' ').trim();
+        return !text || (config.exact ? content === text : content.includes(text));
+      });
+      if (ready && document.readyState === 'complete') send({html: document.documentElement.outerHTML});
+    } catch (error) { send({error: 'The website page could not be read.'}); }
+  }
+  function schedule() {
+    clearTimeout(timer);
+    timer = setTimeout(inspect, 200);
+  }
+  observer = new MutationObserver(schedule);
+  observer.observe(document.documentElement, {childList:true, subtree:true, characterData:true});
+  window.addEventListener('load', schedule, {once:true});
+  schedule();
+})(); true;
+`;
