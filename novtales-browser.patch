+import { useEffect, useSyncExternalStore } from 'react';
+import { AppState, Modal, StyleSheet, Text, View } from 'react-native';
+import { SafeAreaView } from 'react-native-safe-area-context';
+import WebView from 'react-native-webview';
+import { Button } from 'react-native-paper';
+
+import { useTheme } from '@hooks/persisted';
+import { getUserAgent } from '@hooks/persisted/useUserAgent';
+import { getString } from '@i18n/translations';
+import {
+  browserPageCaptureScript,
+  cancelBrowserPage,
+  getBrowserPageRequest,
+  receiveBrowserPage,
+  registerBrowserPageHost,
+  setBrowserPageForeground,
+  subscribeBrowserPage,
+} from '@plugins/helpers/browser';
+
+const BrowserPageHost = () => {
+  const request = useSyncExternalStore(
+    subscribeBrowserPage,
+    getBrowserPageRequest,
+    getBrowserPageRequest,
+  );
+  const theme = useTheme();
+  useEffect(registerBrowserPageHost, []);
+  useEffect(() => {
+    setBrowserPageForeground(AppState.currentState === 'active');
+    const subscription = AppState.addEventListener('change', state => {
+      setBrowserPageForeground(state === 'active');
+    });
+    return () => subscription.remove();
+  }, []);
+
+  if (!request) return null;
+  const cancel = () => cancelBrowserPage(request.id);
+
+  return (
+    <Modal visible animationType="slide" onRequestClose={cancel}>
+      <SafeAreaView
+        style={[styles.container, { backgroundColor: theme.background }]}
+      >
+        <View style={styles.header}>
+          <Text style={[styles.title, { color: theme.onSurface }]}>
+            {request.pluginName}
+          </Text>
+          <Button onPress={cancel}>{getString('common.cancel')}</Button>
+        </View>
+        {request.instruction ? (
+          <Text style={[styles.instruction, { color: theme.onSurfaceVariant }]}>
+            {request.instruction}
+          </Text>
+        ) : null}
+        <WebView
+          key={request.id}
+          source={{ uri: request.url }}
+          userAgent={getUserAgent()}
+          sharedCookiesEnabled
+          setSupportMultipleWindows={false}
+          injectedJavaScript={browserPageCaptureScript(request)}
+          onMessage={({ nativeEvent }) =>
+            receiveBrowserPage(request.id, nativeEvent.data, nativeEvent.url)
+          }
+          onError={({ nativeEvent }) =>
+            cancelBrowserPage(request.id, nativeEvent.description)
+          }
+          onHttpError={({ nativeEvent }) => {
+            if (nativeEvent.statusCode === 404) {
+              cancelBrowserPage(request.id, 'The website page was not found.');
+            }
+          }}
+        />
+      </SafeAreaView>
+    </Modal>
+  );
+};
+
+export default BrowserPageHost;
+
+const styles = StyleSheet.create({
+  container: { flex: 1 },
+  header: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    justifyContent: 'space-between',
+    paddingHorizontal: 16,
+  },
+  title: { fontSize: 18, fontWeight: '600', flex: 1 },
+  instruction: { paddingHorizontal: 16, paddingBottom: 12 },
+});
